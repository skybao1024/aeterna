{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-record-action-request",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "signed": {
      "additionalProperties": false,
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/canonicalization"
        },
        "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "domain": {
          "enum": [
            "aeterna.recovery-record.confirm.v1",
            "aeterna.recovery-record.abandon.v1"
          ],
          "type": "string"
        },
        "operation": {
          "enum": ["recovery_record.confirm", "recovery_record.abandon"],
          "type": "string"
        },
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "recovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "signature_version": {
          "$ref": "common.schema.json#/$defs/signatureVersion"
        },
        "vault_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "wrapper_digest": { "$ref": "common.schema.json#/$defs/base64url32" }
      },
      "required": [
        "account_id",
        "canonicalization",
        "device_id",
        "domain",
        "operation",
        "protocol_version",
        "recovery_id",
        "request_id",
        "signature_version",
        "vault_id"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": { "const": "recovery_record.confirm" }
            }
          },
          "then": { "required": ["wrapper_digest"] }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "recovery_record.abandon" }
            }
          },
          "then": { "not": { "required": ["wrapper_digest"] } }
        }
      ]
    },
    "signature": { "$ref": "common.schema.json#/$defs/base64url64" }
  },
  "required": ["protocol_version", "signed", "signature"],
  "type": "object"
}
