{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:error-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "type": "string"
        },
        "retry_after_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "supported_protocol_versions": {
          "items": { "minimum": 1, "type": "integer" },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["code"],
      "type": "object"
    }
  },
  "required": ["protocol_version", "error"],
  "type": "object"
}
