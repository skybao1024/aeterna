{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-secret-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "recovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "srs": { "$ref": "common.schema.json#/$defs/base64url32" },
        "vault_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "wrapper_digest": { "$ref": "common.schema.json#/$defs/base64url32" }
      },
      "required": [
        "account_id",
        "device_id",
        "recovery_id",
        "srs",
        "vault_id",
        "wrapper_digest"
      ],
      "type": "object"
    },
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/uuid" }
  },
  "required": ["protocol_version", "request_id", "data"],
  "type": "object"
}
