{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:device-binding-request",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "signed": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/canonicalization"
        },
        "domain": {
          "const": "aeterna.device-binding.request.v1",
          "type": "string"
        },
        "operation": { "const": "device_binding.request", "type": "string" },
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "signature_version": {
          "$ref": "common.schema.json#/$defs/signatureVersion"
        },
        "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding_grant_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "public_key": { "$ref": "common.schema.json#/$defs/base64url32" },
        "device_label": { "$ref": "common.schema.json#/$defs/deviceLabel" }
      },
      "required": [
        "canonicalization",
        "domain",
        "operation",
        "protocol_version",
        "signature_version",
        "request_id",
        "binding_grant_id",
        "device_id",
        "public_key"
      ],
      "type": "object"
    },
    "signature": { "$ref": "common.schema.json#/$defs/base64url64" }
  },
  "required": ["protocol_version", "signed", "signature"],
  "type": "object"
}
