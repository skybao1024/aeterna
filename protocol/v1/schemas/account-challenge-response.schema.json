{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:account-challenge-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "data": {
      "additionalProperties": false,
      "properties": {
        "challenge_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "expires_in_seconds": {
          "const": 600,
          "type": "integer"
        },
        "resend_after_seconds": {
          "const": 60,
          "type": "integer"
        }
      },
      "required": [
        "challenge_id",
        "expires_in_seconds",
        "resend_after_seconds"
      ],
      "type": "object"
    }
  },
  "required": ["protocol_version", "request_id", "data"],
  "type": "object"
}
