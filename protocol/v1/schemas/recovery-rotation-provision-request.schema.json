{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-rotation-provision-request",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "signed": {
      "additionalProperties": false,
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/canonicalization"
        },
        "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "domain": {
          "const": "aeterna.recovery-rotation.provision.v1",
          "type": "string"
        },
        "kind": { "$ref": "common.schema.json#/$defs/rotationKind" },
        "operation": {
          "const": "recovery_rotation.provision",
          "type": "string"
        },
        "owner_recovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "recovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "rotation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "signature_version": {
          "$ref": "common.schema.json#/$defs/signatureVersion"
        },
        "source_generation": { "minimum": 1, "type": "integer" },
        "source_policy_epoch": { "minimum": 1, "type": "integer" },
        "target_generation": { "minimum": 2, "type": "integer" },
        "target_policy_epoch": { "minimum": 1, "type": "integer" },
        "vault_id": { "$ref": "common.schema.json#/$defs/uuid" }
      },
      "required": [
        "account_id",
        "canonicalization",
        "device_id",
        "domain",
        "kind",
        "operation",
        "protocol_version",
        "recovery_id",
        "request_id",
        "rotation_id",
        "signature_version",
        "source_generation",
        "source_policy_epoch",
        "target_generation",
        "target_policy_epoch",
        "vault_id"
      ],
      "type": "object"
    },
    "signature": { "$ref": "common.schema.json#/$defs/base64url64" }
  },
  "required": ["protocol_version", "signed", "signature"],
  "type": "object"
}
