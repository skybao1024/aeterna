{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:account-challenge-verification-request",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "challenge_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "code": {
      "maxLength": 8,
      "minLength": 8,
      "pattern": "^[0-9]{8}$",
      "type": "string"
    }
  },
  "required": ["protocol_version", "request_id", "challenge_id", "code"],
  "type": "object"
}
