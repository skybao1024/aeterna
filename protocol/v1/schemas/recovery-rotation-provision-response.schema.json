{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-rotation-provision-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "data": {
      "additionalProperties": false,
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "recovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "rotation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "srs": { "$ref": "common.schema.json#/$defs/base64url32" },
        "target_generation": { "minimum": 2, "type": "integer" },
        "target_policy_epoch": { "minimum": 1, "type": "integer" },
        "vault_id": { "$ref": "common.schema.json#/$defs/uuid" }
      },
      "required": [
        "account_id",
        "device_id",
        "expires_at",
        "recovery_id",
        "rotation_id",
        "srs",
        "target_generation",
        "target_policy_epoch",
        "vault_id"
      ],
      "type": "object"
    }
  },
  "required": ["protocol_version", "request_id", "data"],
  "type": "object"
}
